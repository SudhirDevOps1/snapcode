# Fail installs on unsupported Node versions (see "engines" in package.json).
engine-strict=true
# Known peer-range conflicts in the current toolchain (typescript-eslint and TypeScript 6 ranges).
# Remove once the upstream peer ranges align; tracked in docs/ROADMAP.md.
legacy-peer-deps=true
# Reproducible, quiet installs for CI and contributors.
fund=false
audit=true
audit-level=high
