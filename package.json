{
  "name": "snapcode",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "prebuild": "npm run icons",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postbuild": "node scripts/finalize-build.mjs",
    "predev": "npm run icons",
    "docs:screenshots": "node scripts/capture-screenshots.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anonymous-pro": "^5.3.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/cascadia-code": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/overpass-mono": "^5.3.0",
    "@fontsource/red-hat-mono": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/ubuntu-mono": "^5.3.0",
    "@fontsource/victor-mono": "^5.3.0",
    "clsx": "2.1.1",
    "gifenc": "^1.0.3",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "^5.1.0"
  },
  "description": "Turn code into beautiful, shareable images. Offline-first installable PWA.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
